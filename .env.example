# Data paths
ROOT_DIR=/path/to/your/data/root

# Weights & Biases configuration (for training)
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=breast-cancer-detection
WANDB_ENTITY=your_wandb_entity

# API configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model paths (optional, defaults to best_model_saved/)
SEGMENTATION_MODEL_PATH=best_model_saved/best_model.pth
SEGMENTATION_CONFIG_PATH=best_model_saved/config.json
